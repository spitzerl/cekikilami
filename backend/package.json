{
  "name": "music-game-backend",
  "version": "1.0.0-beta.9",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --import ./test/setup.js --test --test-concurrency=1 --test-force-exit test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --import ./test/setup.js --test --test-concurrency=1 --test-force-exit test/unit/*.test.js",
    "test:integration": "node --import ./test/setup.js --test --test-concurrency=1 --test-force-exit test/integration/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
