# Ce fichier est utilisé par Docker Compose. Le script scripts/deploy.sh
# le génère automatiquement avec des secrets aléatoires s'il est absent.
POSTGRES_ADMIN_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
POSTGRES_DB=music_game

APP_DB_USER=cekikilami
APP_DB_PASSWORD=replace-with-a-long-random-app-password

REDIS_PASSWORD=replace-with-a-long-random-redis-password

# Origine publique utilisée par le navigateur et CORS.
APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# Passerelle intégrée (Nginx non-root, port interne 8080).
# 127.0.0.1:8080 convient à un reverse proxy TLS local ou à un test local.
# Pour une exposition directe : GATEWAY_BIND=0.0.0.0 et GATEWAY_PORT=80.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080

# La passerelle transmet un X-Forwarded-For déjà résolu.
TRUST_PROXY=1

VITE_API_URL=/api
VITE_SOCKET_URL=
MAX_SESSIONS=500
